{
    "_说明": "========= 配置模板 =========",
    "_说明2": "复制本文件为 config.json，然后填入你自己的信息",

    "数据源": {
        "类型": "excel",
        "_类型说明": "填 'excel' 或 'mysql'",
        "Excel文件目录": "./data",
        "_Excel说明": "系统会自动读取 data 目录下最新的 Excel 文件",
        "MySQL": {
            "主机": "localhost",
            "端口": 3306,
            "用户名": "root",
            "密码": "请填写你的MySQL密码",
            "数据库名": "sales",
            "表名": "daily_sales",
            "连接超时秒": 10,
