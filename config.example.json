            "_说明": "数据源类型设为 'mysql' 且自动导出为 true 时，main.py 会先从数据库导出 Excel 再分析"
        }
    },

    "异常检测": {
        "环比阈值_百分比": 30,
        "_环比说明": "涨跌超过这个百分比就算异常，默认30%",
        "启用同比检测": false,
        "_同比说明": "需要有至少一年的历史数据才能用",
        "零销量检测": true,
        "_零销量说明": "昨天销量为0但前天有销量，标记为断崖式下跌",
        "库存紧张阈值": 10,
        "_库存紧张说明": "库存低于此数量时触发库存不足预警，需配合日进货量列使用"
    },

    "AI分析": {
        "启用": true,
        "API地址": "https://api.deepseek.com/anthropic/v1/messages",
        "API密钥": "请填写你的DeepSeek API密钥",
        "模型": "deepseek-v4-pro",
        "_说明": "API密钥和地址已经配置好，一般不需要修改"
    },

    "推送": {
        "钉钉": {
            "启用": true,
            "Webhook地址": "请填写你的钉钉机器人Webhook地址",
            "_说明": "去钉钉群设置里添加一个自定义机器人，复制 Webhook 地址填到这里"
        },
        "邮箱": {
            "启用": false,
            "SMTP服务器": "smtp.qq.com",
            "SMTP端口": 587,
            "发件邮箱": "",
            "授权码": "",
            "收件邮箱": "",
            "_说明": "以QQ邮箱为例：开启SMTP服务后获取授权码，填到这里"
        }
    }
}
